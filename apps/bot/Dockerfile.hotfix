# Hotfix image (local-only): rebuild bot from the existing local image when the
# registry (docker.io) is unreachable. The root .dockerignore excludes **/dist,
# so build from a staged context, NOT the repo root:
#
#   $st="$env:TEMP\opencode\hotfix\bot"; New-Item -ItemType Directory -Force $st
#   Copy-Item apps\bot\dist "$st\dist" -Recurse
#   Copy-Item apps\bot\Dockerfile.hotfix "$st\Dockerfile"
#   docker build -t loki-bot $st
#
# On the VPS with registry access use the normal `docker compose build` instead.
FROM loki-bot:latest
COPY dist /app/apps/bot/dist
CMD ["node", "apps/bot/dist/index.js"]
