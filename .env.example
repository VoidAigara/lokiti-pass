# ============================================================
#  Loki Ti Pass — пример окружения. Скопируйте в .env
#  cp .env.example .env   и заполните значения.
#  Файл .env НИКОГДА не коммитится (см. .gitignore).
# ============================================================

# --- Общее ---
NODE_ENV=production
TZ=Europe/Moscow
LOG_LEVEL=info

# --- Публичные адреса ---
# Домен, на котором живёт сайт (без https://)
WEB_URL=https://pass.lokiti.ru
API_URL=https://api.pass.lokiti.ru
# Отдельный домен/поддомен бота не нужен — Telegram сам дёргает API_URL

# --- PostgreSQL ---
POSTGRES_USER=loki
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=lokipass
DATABASE_URL=postgresql://loki:CHANGE_ME_STRONG_PASSWORD@postgres:5432/lokipass?schema=public

# --- Redis (BullMQ) ---
REDIS_URL=redis://redis:6379

# --- Telegram ---
# ВНИМАНИЕ: токен из BotFather — секрет. Если он попал в чат/репозиторий —
# перевыпустите через /revoke в @BotFather и вставьте новый сюда.
BOT_TOKEN=CHANGE_ME_BOT_TOKEN
# ID Telegram администраторов (стримерша + модераторы), через запятую
ADMIN_TG_IDS=123456789,987654321

# --- Auth ---
# 32+ байта в hex — для подписи JWT
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_TTL=7d
# Секретный заголовок x-internal-token для серверных вызовов бот → API.
# Обязательно 32+ символов случайной строки; значения с CHANGE_ME API отвергает.
INTERNAL_TOKEN=CHANGE_ME_RANDOM_32_PLUS_CHARS_STRING
# Доверенные reverse-proxy перед API (IP/CIDR через запятую).
# Пусто (по умолчанию) — X-Forwarded-For игнорируется, подделать IP нельзя.
# Пример за nginx на том же хосте: TRUSTED_PROXIES=127.0.0.1/32,::1/128
TRUSTED_PROXIES=

# --- YooKassa ---
# Доступ из личного кабинета https://yookassa.ru/my-applications
YOOKASSA_SHOP_ID=CHANGE_ME
YOOKASSA_SECRET_KEY=CHANGE_ME
# IP-подсети вебхуков YooKassa (актуальный список — в их документации).
# Пусто = IP-проверка выключена, но содержимое вебхука всё равно сверяется
# с YooKassa API (fail-closed): несовпадение суммы/status ⇒ отказ.
YOOKASSA_WEBHOOK_IPS=93.184.216.34/32
# Идемпотентный ключ для создания платежей (можно сгенерировать один раз)
YOOKASSA_IDEMPOTENCE_KEY=
# Чеки по 54-ФЗ (опционально): включить, если у вас есть касса/оператор фискальных данных.
# YOOKASSA_RECEIPT=true подключает receipt к платежу (нужен contract с ОФД).
YOOKASSA_RECEIPT=false
# НДС: 1 = без НДС, 2 = НДС 0%, 3 = 5%, 4 = 7%, 5 = 10%, 6 = 20%
YOOKASSA_VAT_CODE=1
# Система налогообложения: 1 = ОСН, 2 = УСН, 3 = УСН-доходы, 4 = патент, 5 = ЕСХН, 6 = НПД
YOOKASSA_TAXATION_SYSTEM=1
# Доверять payload вебхука без сверки с YooKassa API — ТОЛЬКО локальная
# разработка/smoke (YooKassa не настроена). В проде всегда false.
DEMO_WEBHOOK_TRUST=false

# --- Next.js сайт (брендируются при СБОРКЕ образа web) ---
# После изменения этих значений пересоберите web: docker compose build web
# API сайта всегда по относительному /api — локально это Next rewrite,
# во внешнем доступе — public-proxy (scripts/public-proxy.mjs).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WEB_URL=https://pass.lokiti.ru
NEXT_PUBLIC_BOT_USERNAME=lokiti_bot
NEXT_PUBLIC_MC_IP=play.lokiti.ru

# --- Telegram Stars (fallback для зарубежных) ---
STARS_ENABLED=true
# Сколько рублей стоит одна звезда при пересчёте цены (задаётся в @BotFather)
STARS_RUB_PER_STAR=2
# Куда слать алерты о падении сервисов (id чата/канала)
ALERT_CHAT_ID=

# --- Minecraft RCON ---
MC_HOST=minecraft
MC_RCON_PORT=25575
MC_RCON_PASSWORD=CHANGE_ME_RCON_PASSWORD
# IP:port для карты онлайна (GameQuery), например play.example.ru:25565
MC_QUERY_HOST=minecraft
MC_QUERY_PORT=25565
MC_SERVER_IP=play.lokiti.ru

# --- Очередь ---
QUEUE_WHITELIST_CONCURRENCY=2
QUEUE_ATTEMPTS=5

# --- Админ-доступ к /admin/* API (CIDR через запятую; пусто = любые IP,
# но тогда обязательно сильный JWT + 2FA-нет — оставляйте хотя бы свой IP)
ADMIN_IP_ALLOWLIST=

# --- Ограничения ---
RATE_LIMIT_PER_MIN=10
